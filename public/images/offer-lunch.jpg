<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="100%" height="100%">
  <defs>
    <radialGradient id="bg" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#2A1512"/>
      <stop offset="100%" stop-color="#121214"/>
    </radialGradient>
    <radialGradient id="crust" cx="50%" cy="50%" r="50%">
      <stop offset="70%" stop-color="#D9822B"/>
      <stop offset="90%" stop-color="#9E4D15"/>
      <stop offset="100%" stop-color="#5C2908"/>
    </radialGradient>
    <radialGradient id="cheese" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#FFEAA7"/>
      <stop offset="60%" stop-color="#FDCB6E"/>
      <stop offset="100%" stop-color="#E17055"/>
    </radialGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="10" stdDeviation="12" flood-color="#000" flood-opacity="0.6"/>
    </filter>
  </defs>
  
  <rect width="400" height="400" fill="url(#bg)" rx="24"/>
  
  <!-- Outer Crust -->
  <circle cx="200" cy="200" r="140" fill="url(#crust)" filter="url(#shadow)"/>
  
  <!-- Char blisters -->
  <circle cx="120" cy="110" r="6" fill="#2D1305" opacity="0.8"/>
  <circle cx="270" cy="100" r="8" fill="#2D1305" opacity="0.8"/>
  <circle cx="290" cy="260" r="7" fill="#2D1305" opacity="0.8"/>
  <circle cx="110" cy="250" r="9" fill="#2D1305" opacity="0.8"/>

  <!-- Cheese & Sauce -->
  <circle cx="200" cy="200" r="115" fill="url(#cheese)"/>
  
  <!-- Pepperoni Slices -->
  <circle cx="160" cy="150" r="22" fill="#C0392B" stroke="#922B21" stroke-width="2"/>
  <circle cx="240" cy="160" r="24" fill="#C0392B" stroke="#922B21" stroke-width="2"/>
  <circle cx="160" cy="240" r="23" fill="#C0392B" stroke="#922B21" stroke-width="2"/>
  <circle cx="240" cy="240" r="22" fill="#C0392B" stroke="#922B21" stroke-width="2"/>
  <circle cx="200" cy="200" r="25" fill="#C0392B" stroke="#922B21" stroke-width="2"/>

  <!-- Basil Leaves -->
  <path d="M 190 130 C 180 110 210 110 200 130 Z" fill="#27AE60"/>
  <path d="M 130 200 C 110 190 110 220 130 210 Z" fill="#27AE60"/>
  <path d="M 270 200 C 290 190 290 220 270 210 Z" fill="#27AE60"/>
  <path d="M 200 270 C 190 290 220 290 210 270 Z" fill="#27AE60"/>

  <!-- Olives -->
  <circle cx="140" cy="180" r="6" fill="#1E272C"/>
  <circle cx="260" cy="180" r="6" fill="#1E272C"/>
  <circle cx="200" cy="160" r="6" fill="#1E272C"/>
  <circle cx="180" cy="220" r="6" fill="#1E272C"/>
  <circle cx="220" cy="220" r="6" fill="#1E272C"/>
</svg>
